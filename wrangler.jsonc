{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "viewinvai",
  "main": "worker.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
