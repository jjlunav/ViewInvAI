{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "viewinvai",
  "main": "worker.js",
  "keep_vars": true,
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Los catálogos pasan por el Worker: así llevan las cabeceras CORS que necesita la APK
    // (origen https://localhost). Servidos como estáticos puros, Android bloquea la descarga.
    // «/», auth.js y portfolio.js también: la APK carga la versión publicada (fetch y módulos) y necesita CORS.
    "run_worker_first": ["/data/*", "/", "/auth.js", "/portfolio.js", "/fonts/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
    "FIREBASE_PROJECT_ID": "viewinvai",
    "SEC_USER_AGENT": "ViewInvAI/1.0 (https://viewinvai.firebaseapp.com)",
    "MARKET_DISPATCH_MINUTES": "30",
    "MARKET_LIVE_URL": "https://viewinvai-data.vercel.app/api/market-live",
    "MARKET_SERVER_URL": "https://viewinvai-data.vercel.app/api/market-server",
    "MARKET_LIVE_URL_2": "https://viewinvai-data.netlify.app/market-live",
    "MARKET_SERVER_URL_2": "https://viewinvai-data.netlify.app/market-server"
  },
  "triggers": {
    "crons": [
      "* * * * 1-7",
      "* * * * *",
      "*/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "viewinvai-db",
      "database_id": "36134c26-075e-4602-9fde-da449187892d",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "HOT_STATE_KV",
      "id": "c8a5ad6458c44f64a03d876bede73f91"
    }
  ],
  "ratelimits": [
    {"name":"AI_RATE_LIMITER_10","namespace_id":"5606104","simple":{"limit":10,"period":60}},
    {"name":"MARKET_RATE_LIMITER_12","namespace_id":"5606110","simple":{"limit":12,"period":60}},
    {"name":"MARKET_RATE_LIMITER_20","namespace_id":"5606111","simple":{"limit":20,"period":60}},
    {"name":"MARKET_RATE_LIMITER_30","namespace_id":"5606112","simple":{"limit":30,"period":60}},
    {"name":"MARKET_RATE_LIMITER_40","namespace_id":"5606113","simple":{"limit":40,"period":60}},
    {"name":"MARKET_RATE_LIMITER_60","namespace_id":"5606114","simple":{"limit":60,"period":60}},

    {"name":"MARKET_RATE_LIMITER","namespace_id":"5606103","simple":{"limit":90,"period":60}},
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "5606101",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "5606102",
      "simple": {
        "limit": 180,
        "period": 60
      }
    }
  ]
}
