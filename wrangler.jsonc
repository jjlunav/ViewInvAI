{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "viewinvai",
  "main": "worker.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "FIREBASE_PROJECT_ID": "viewinvai",
    "SEC_USER_AGENT": "ViewInvAI/1.0 (https://viewinvai.firebaseapp.com)"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "viewinvai-db",
      "database_id": "36134c26-075e-4602-9fde-da449187892d",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "5606101",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "5606102",
      "simple": {
        "limit": 180,
        "period": 60
      }
    }
  ]
}
