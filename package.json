    "test:tax": "node scripts/test_tax_two_months.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/app": "^8.0.0",
    "jose": "6.2.12",
    "@capacitor-firebase/authentication": "8.5.2",
    "firebase": "12.19.0",
    "@capacitor-firebase/messaging": "8.5.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capgo/capacitor-native-biometric": "8.7.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  }
