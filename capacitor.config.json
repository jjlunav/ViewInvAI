{
  "appId": "com.viewinvai.mobile",
  "appName": "ViewInvAI",
  "webDir": "mobile-shell",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#071018"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": [
        "google.com"
      ]
    },
    "FirebaseMessaging": {
      "presentationOptions": [
        "alert",
        "badge",
        "sound"
      ]
    }
  }
}
